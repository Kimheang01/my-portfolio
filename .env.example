# Copy this file to .env.local and fill in the values. .env.local is not
# committed; set the same variables in your hosting provider's settings.

# PostgreSQL connection string, e.g. from Neon or Supabase:
# postgres://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# ── Admin login (/admin) ───────────────────────────────────────────────
# Without these the public site still works; only /admin shows an error.

# The site's address: http://localhost:3000 here, your domain in production.
BETTER_AUTH_URL=http://localhost:3000
# A random string of 32+ characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# From your GitHub OAuth app (GitHub → Settings → Developer settings →
# OAuth Apps). Its callback URL is <BETTER_AUTH_URL>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The numeric id of the one GitHub account allowed in, from
# https://api.github.com/users/<username> ("id").
ADMIN_GITHUB_ID=
